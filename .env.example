# --- Adapter mode --------------------------------------------------------------
# real: Clerk, Vercel Blob, Upstash Redis, QStash. fake: in-memory doubles for
# those external services. Postgres is ALWAYS real.
AEROPASS_ADAPTERS=fake

# --- Neon Postgres ----------------------------------------------------------------
# Pooled (PgBouncer) for the app; direct only for Alembic.
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/aeropass?ssl=require
DATABASE_URL_DIRECT=postgresql+asyncpg://user:pass@ep-xxx.sa-east-1.aws.neon.tech/aeropass?ssl=require
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aeropass_test

# --- Vercel Blob (store privado) ---------------------------------------------------
BLOB_READ_WRITE_TOKEN=
BLOB_TIMEOUT_SECONDS=3

# --- Upstash Redis -----------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash QStash ----------------------------------------------------------------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_EVENTS_URL_GROUP=aeropass-eventos
QSTASH_TIMEOUT_SECONDS=2
# Public URL of the deployment: validates the "url" claim of the QStash signature and is
# used by the script that creates the dispatcher schedule.
PUBLIC_BASE_URL=https://aeropass.vercel.app

# --- Clerk -------------------------------------------------------------------------
CLERK_SECRET_KEY=
# Optional: authorized origins (azp), comma-separated
CLERK_AUTHORIZED_PARTIES=

# --- QR signing (Ed25519) — generate with: uv run python -m aeropass.tools.gen_signing_key
QR_SIGNING_PRIVATE_KEY=
QR_SIGNING_KID=
QR_TTL_SECONDS=45

# --- Biometric provider --------------------------------------------------------------
BIOMETRIC_PROVIDER=mock
BIOMETRIC_LIVENESS_THRESHOLD=0.80
BIOMETRIC_MATCH_THRESHOLD=0.80
BIOMETRIC_TIMEOUT_SECONDS=4
VISION_PROVIDER_URL=
VISION_PROVIDER_API_KEY=
